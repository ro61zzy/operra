{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
     "types": ["node"]
  },
  "include": ["src", "prisma.config.ts", "src/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}